{
    "name": "atannex/generator",
    "description": "Unique, human-readable codes for Laravel: reference numbers, invoice sequences, staff IDs, vouchers and tokens from one pattern language.",
    "keywords": ["laravel", "code", "generator", "sequence", "invoice-number", "reference", "eloquent"],
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "Atanga Leke Collins", "email": "atangageihlekecollins@gmail.com" }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "Atannex\\Generator\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Atannex\\Generator\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Atannex\\Generator\\GeneratorServiceProvider"],
            "aliases": { "Generator": "Atannex\\Generator\\Facades\\Generator" }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
